<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <!-- Decides the versions of Quarkus, quarkus-lambda-platform, the plugins and the libraries below, so they are always
       compatible, and brings quarkus-config-yaml, quarkus-logging-json, Lombok, MapStruct and quarkus-junit:
       https://github.com/User-Jean/quarkus-lambda-platform. To upgrade, change only this version -->
  <parent>
    <groupId>com.xdyan</groupId>
    <artifactId>quarkus-lambda-parent</artifactId>
    <version>QUARKUS_LAMBDA_COMMONS_VERSION</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>quarkus-lambda-http-template</artifactId>
  <!-- Set from the git tags by maven-git-versioning-extension (.mvn/), don't edit it -->
  <version>${revision}</version>

  <properties>
    <revision>0.0.0-SNAPSHOT</revision>
  </properties>

  <dependencies>
    <!-- The HTTP stack: quarkus-amazon-lambda-http, quarkus-resteasy-jackson, quarkus-hibernate-validator and
         quarkus-amazon-lambda-xray, plus errors, request logs, X-Ray (@XRayTraced), Clock and DateTimeMapper -->
    <dependency>
      <groupId>com.xdyan</groupId>
      <artifactId>quarkus-lambda-commons-http</artifactId>
    </dependency>

    <!-- MySQL -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>


    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Configured in the parent: the build of the lambda (also native, -Pnative). The code of
       src/main/resources/openapi.yaml is generated by the parent too (profile contract-first), nothing to declare -->
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
