<?xml version="1.0"?>
<!--
  Build of quarkus-lambda-commons: the modules and what only the library needs (Jandex index, Lombok, test
  dependencies). The versions and the metadata come from quarkus-lambda-dependencies, the same versions the apps get
  through quarkus-lambda-parent. Not quarkus-lambda-parent itself: its dependencies would reach every app through the
  modules.
-->
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xdyan</groupId>
    <artifactId>quarkus-lambda-dependencies</artifactId>
    <version>${revision}</version>
    <relativePath>quarkus-lambda-dependencies/pom.xml</relativePath>
  </parent>
  <artifactId>quarkus-lambda-commons-parent</artifactId>
  <packaging>pom</packaging>
  <name>quarkus-lambda-commons</name>
  <description>Shared Quarkus code for AWS Lambda</description>

  <modules>
    <module>quarkus-lambda-dependencies</module>
    <module>quarkus-lambda-code-rules</module>
    <module>quarkus-lambda-parent</module>
    <module>commons-core</module>
    <module>commons-http</module>
  </modules>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <!-- META-INF/jandex.idx in each jar: without it Quarkus doesn't discover the beans, providers and
           interceptors of the library in the apps -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The rules of the code, the same as the lambdas (quarkus-lambda-code-rules) -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
