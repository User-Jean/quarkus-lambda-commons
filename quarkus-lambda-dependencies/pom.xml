<?xml version="1.0"?>
<!--
  The versions of the Quarkus lambdas, without configuring anything: Quarkus, the modules of quarkus-lambda-platform,
  Lombok, MapStruct and the plugins. Parent of the library (pom.xml at the root) and of quarkus-lambda-parent, the
  parent of the apps. An app uses quarkus-lambda-parent, not this one.
-->
<project child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.xdyan</groupId>
  <artifactId>quarkus-lambda-dependencies</artifactId>
  <!-- Set from the git tags by maven-git-versioning-extension (.mvn/), don't edit it -->
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>quarkus-lambda-dependencies</name>
  <description>Versions of the Quarkus lambdas: Quarkus, quarkus-lambda-platform, the libraries and the plugins</description>
  <url>https://github.com/User-Jean/quarkus-lambda-platform</url>

  <!-- Required by Maven Central, inherited by the modules as they are (without appending their artifactId to the
       url and scm: child.*.inherit.append.path). An app inherits them too; it can declare its own -->
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>user-jean</id>
      <name>xdyan</name>
      <url>https://github.com/User-Jean</url>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/User-Jean/quarkus-lambda-platform.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/User-Jean/quarkus-lambda-platform.git</developerConnection>
    <url>https://github.com/User-Jean/quarkus-lambda-platform</url>
  </scm>

  <properties>
    <revision>0.0.0-SNAPSHOT</revision>
    <!-- The version of quarkus-lambda-platform: the one of this pom, written by the versioning extension
         (.mvn/maven-git-versioning-extension.xml). ${project.version} would be the version of the app -->
    <quarkus-lambda-commons.version>0.0.0-SNAPSHOT</quarkus-lambda-commons.version>

    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Quarkus: the BOM and the plugin always in the same version -->
    <quarkus.platform.version>3.34.4</quarkus.platform.version>

    <!-- Libraries the lambdas use outside the Quarkus BOM -->
    <lombok.version>1.18.48</lombok.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <jackson-databind-nullable.version>0.2.13</jackson-databind-nullable.version>

    <!-- Plugins -->
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <surefire-plugin.version>3.6.1</surefire-plugin.version>
    <openapi-generator-plugin.version>7.27.0</openapi-generator-plugin.version>
    <jandex-plugin.version>3.6.1</jandex-plugin.version>
    <source-plugin.version>3.4.0</source-plugin.version>
    <javadoc-plugin.version>3.12.0</javadoc-plugin.version>
    <gpg-plugin.version>3.2.8</gpg-plugin.version>
    <central-publishing-plugin.version>0.12.0</central-publishing-plugin.version>
    <!-- quarkus-lambda-http-archetype: its packaging and its test -->
    <archetype-plugin.version>3.4.1</archetype-plugin.version>
    <jar-plugin.version>3.5.1</jar-plugin.version>

    <!-- Rules of the code (quarkus-lambda-code-rules): format, Checkstyle and PMD -->
    <spotless-plugin.version>3.12.0</spotless-plugin.version>
    <google-java-format.version>2.0.0</google-java-format.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>14.4.0</checkstyle.version>
    <pmd-plugin.version>3.28.0</pmd-plugin.version>
    <pmd.version>7.29.0</pmd.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.xdyan</groupId>
        <artifactId>quarkus-lambda-commons-core</artifactId>
        <version>${quarkus-lambda-commons.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xdyan</groupId>
        <artifactId>quarkus-lambda-commons-http</artifactId>
        <version>${quarkus-lambda-commons.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
        <version>${jackson-databind-nullable.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>${jandex-plugin.version}</version>
        </plugin>

        <!-- Rules of the code: Checkstyle in validate (before compiling), PMD in process-classes (it needs the
             classes), so ./mvnw test already runs both; the format in verify, so a space doesn't stop the tests while
             developing. Only src/main/java and src/test/java: the code generated from the openapi.yaml (target/) is
             not checked -->
        <!-- Format: google-java-format, not configurable. ./mvnw spotless:apply formats the code -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-plugin.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>${google-java-format.version}</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>check-format</id>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- Names, imports and braces: quarkus-lambda/checkstyle.xml of quarkus-lambda-code-rules -->
        <plugin>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
            <dependency>
              <groupId>com.xdyan</groupId>
              <artifactId>quarkus-lambda-code-rules</artifactId>
              <version>${quarkus-lambda-commons.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>quarkus-lambda/checkstyle.xml</configLocation>
            <sourceDirectories>
              <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
            </sourceDirectories>
            <testSourceDirectories>
              <testSourceDirectory>${project.build.testSourceDirectory}</testSourceDirectory>
            </testSourceDirectories>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <violationSeverity>warning</violationSeverity>
          </configuration>
          <executions>
            <execution>
              <id>check-style</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- Bugs and bad practices: quarkus-lambda/pmd-ruleset.xml of quarkus-lambda-code-rules -->
        <plugin>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>com.xdyan</groupId>
              <artifactId>quarkus-lambda-code-rules</artifactId>
              <version>${quarkus-lambda-commons.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <rulesets>
              <ruleset>quarkus-lambda/pmd-ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${maven.compiler.release}</targetJdk>
            <includeTests>true</includeTests>
            <excludeRoots>
              <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
              <excludeRoot>${project.build.directory}/generated-test-sources</excludeRoot>
            </excludeRoots>
            <printFailingErrors>true</printFailingErrors>
            <linkXRef>false</linkXRef>
          </configuration>
          <executions>
            <execution>
              <id>check-pmd</id>
              <phase>process-classes</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Publishing of quarkus-lambda-platform to Maven Central (workflow "Release"): sources, javadoc, GPG signatures
         and the upload to the Central Portal. Needs the server "central" in settings.xml (user token) and the GPG key.
         Here, the parent of every published pom, so all of them are signed and uploaded. Not for the apps -->
    <profile>
      <id>publish-central</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc-plugin.version}</version>
            <configuration>
              <!-- Not every public method has javadoc: a missing comment is not an error -->
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg-plugin.version}</version>
            <configuration>
              <!-- The passphrase comes from the env var MAVEN_GPG_PASSPHRASE, without a terminal -->
              <bestPractices>true</bestPractices>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Uploads all the modules as one deployment and publishes it once validated. A version published to
               Maven Central can never be changed nor deleted -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <deploymentName>quarkus-lambda-platform ${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
